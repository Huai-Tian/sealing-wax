# 火漆 · Sealing Wax — R8 keep rules
#
# JNI surface: native code resolves sealing.wax.bridge.WaxNative methods by
# their exact Java names; obfuscation or removal breaks System.loadLibrary.
-keep class sealing.wax.bridge.WaxNative { *; }

# Release log stripping (§9: release 剥离日志且永不打印密钥/明文).
-assumenosideeffects class android.util.Log {
    public static *** v(...);
    public static *** d(...);
    public static *** i(...);
    public static *** w(...);
    public static *** e(...);
}
